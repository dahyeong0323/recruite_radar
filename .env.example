# Safe defaults: dry-run uses a disposable runtime Vault and never pushes or sends Telegram.
DRY_RUN=true
DRY_RUN_VAULT_ROOT=
VAULT_ROOT=/data/obsidian
VAULT_RELATIVE_PATH=Career/Recruiting_Radar
VAULT_BRANCH=master
VAULT_GIT_URL=
GITHUB_TOKEN=
SSH_DEPLOY_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

SARAMIN_ACCESS_KEY=
SARAMIN_DAILY_LIMIT=470
SARAMIN_KEYWORDS_PER_RUN=8
OPENAI_API_KEY=
OPENAI_MODEL_CLASSIFIER=
TZ=Asia/Seoul
SCHEDULER_ENABLED=true

KVCA_LIST_URL=https://roadshow.kvca.or.kr/Program/user_board/list.html?a_cd=7&a_gb=board&a_item=0&key=&keyfield=&page={page}&sm=3_2
VCS_LIST_URL=https://www.vcs.go.kr/web/portal/recruitment/list?page={page}
KOFIA_LIST_URL=https://www.kofia.or.kr/brd/m_96/list.do?company_cd=&company_nm=&itm_seq_1=0&itm_seq_2=0&multi_itm_seq=0&page={page}&srchFr=&srchTo=&srchTp=&srchWord=
SARAMIN_API_URL=https://oapi.saramin.co.kr/job-search
